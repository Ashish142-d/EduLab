# ---- Postgres (Supabase) ----
# Transaction pooler (app runtime) + Session pooler (migrations)
DATABASE_URL="postgresql://USER:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=no-verify"
DIRECT_URL="postgresql://USER:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=no-verify"

# ---- Clerk (https://dashboard.clerk.com) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ---- AI tutor (OpenAI-compatible; Mistral shown) ----
# Works with Mistral / OpenAI / Groq / DeepSeek / OpenRouter — swap base/key/model.
AI_API_KEY=your-key-here
AI_API_BASE="https://api.mistral.ai/v1"
AI_MODEL="mistral-small-latest"
